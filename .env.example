# copy to .env and fill in ONE provider block. Pick a tool-capable model.
# Model names change often: check the provider's model list before use.

# --- Groq (free tier, fast) ---------------------------------------
API_KEY=gsk_...
BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-120b
# free tier = 8k tokens/min PER MODEL, so spread the roles across models.
# (qwen models there also cap OUTPUT at 1k tokens/min: too low for reading/critic)
SMALL_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
CRITIC_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=openai/gpt-oss-20b=low,openai/gpt-oss-120b=low
SHORTLIST_K=8

# --- Google Gemini (free tier) --------------------------------------
# API_KEY=AIza...
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL=gemini-2.5-flash

# --- Ollama (local, no key, data stays on your machine) ------------
# API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL=qwen2.5:7b

# --- optional --------------------------------------------------------
# STRONG_MODEL=          # planner, writer (defaults to MODEL)
# CRITIC_MODEL=          # ideally different from the writer
# SMALL_MODEL=a,b        # comma list: reading is spread round-robin over these models
# REASONING_EFFORT=model=low,...   # fewer hidden reasoning tokens (dropped if unsupported)
# TOKEN_BUDGET=80000     # Session 2 agent per-run cap
# SHORTLIST_K=12         # papers sent to the reader
# PRE_SCREEN_K=36        # papers the LLM grades (default 3 x SHORTLIST_K; rest by keywords)
# LLM_WORKERS=4          # parallel grading/reading calls
# OPENALEX_EMAIL=you@example.com   # OpenAlex polite pool (faster)
# S2_API_KEY=            # Semantic Scholar key (fewer HTTP 429s)
