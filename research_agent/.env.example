# copy to .env and fill in ONE provider block. Pick a tool-capable model.
# Model names change often: check the provider's model list before use.

# --- Groq (free tier, fast) ---------------------------------------
API_KEY=gsk_...
BASE_URL=https://api.groq.com/openai/v1
MODEL=llama-3.3-70b-versatile
SMALL_MODEL=llama-3.1-8b-instant

# --- Google Gemini (free tier) --------------------------------------
# API_KEY=AIza...
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL=gemini-2.5-flash

# --- Ollama (local, no key, data stays on your machine) ------------
# API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL=qwen2.5:7b

# --- optional --------------------------------------------------------
# STRONG_MODEL=          # planner, writer (defaults to MODEL)
# CRITIC_MODEL=          # ideally different from the writer
# TOKEN_BUDGET=80000     # Session 2 agent per-run cap
# SHORTLIST_K=12         # papers sent to the reader
# OPENALEX_EMAIL=you@example.com   # OpenAlex polite pool (faster)
# S2_API_KEY=            # Semantic Scholar key (fewer HTTP 429s)
